# Copy this to .env and fill in the values -- or just run ./setup.sh, which
# automates everything below except the two steps that need an actual human
# (installing Luci itself, signing up for a Voyage key). See its comments
# for what each step can/can't do for you.

# --- Luci (screen-memory MCP) ------------------------------------------
# Luci must already be installed and running on THIS machine (screen
# capture + OCR + ASR) -- there's no remote/hosted mode, so everyone who
# wants their own live dashboard needs their own local Luci. LUCI_MCP_URL
# is always the loopback address below (Luci has no other endpoint).
# LUCI_MCP_TOKEN is the bearer token Luci issued when you set it up --
# find it in Luci's own settings, this project can't generate it for you.
LUCI_MCP_URL=http://127.0.0.1:8765/mcp
LUCI_MCP_TOKEN=

# --- Web push notifications (VAPID key pair) ----------------------------
# setup.sh generates these three automatically -- you should never need to
# hand-write them. VAPID_SUBJECT just has to be a mailto: or https: URL
# identifying you as the sender, per the Web Push spec (any real address
# of yours works, browsers only use it to contact you if you're abusing
# their push service).
VAPID_PRIVATE_KEY_B64=
VAPID_PUBLIC_KEY_B64=
VAPID_SUBJECT=

# --- RAG chatbot (Voyage AI embeddings) ----------------------------------
# Optional. Without this, the dashboard chatbot still answers general F1
# questions fine (pure web-search fallback, no key needed) -- it just
# can't ground answers in this specific race's own detected events yet.
# Get a free key at https://dashboard.voyageai.com/, or ask whoever
# invited you for a shared project key. setup.sh walks you through both.
VOYAGE_API_KEY=
# Set to true ONLY if the key above is a *shared* project key someone
# handed you, not one you signed up for yourself -- this turns on the
# per-installation quota (backend/rag.py) so nobody installation can burn
# through the whole shared key alone. Leave false/blank for a personal key.
VOYAGE_KEY_SHARED=false
